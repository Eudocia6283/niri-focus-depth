+#[test]
+fn focus_depth_scale_opacity_and_stacking() {
+    use approx::assert_abs_diff_eq;
+
+    const LINEAR: Kind = Kind::Easing(EasingParams {
+        duration_ms: 1000,
+        curve: Curve::Linear,
+    });
+
+    let mut options = Options {
+        layout: niri_config::Layout {
+            gaps: 16.0,
+            center_focused_column: niri_config::CenterFocusedColumn::Always,
+            border: niri_config::Border {
+                off: true,
+                ..Default::default()
+            },
+            focus_depth: niri_config::FocusDepth {
+                off: false,
+                inactive_scale: 0.9,
+                inactive_opacity: 0.75,
+                inactive_blur: 2.0,
+                stack_overlap: 40.0,
+            },
+            ..Default::default()
+        },
+        ..Options::default()
+    };
+    options.animations.horizontal_view_movement.0.kind = LINEAR;
+
+    let mut layout = check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::AddWindow {
+                params: TestWindowParams::new(2),
+            },
+            Op::AddWindow {
+                params: TestWindowParams::new(3),
+            },
+            Op::SetForcedSize {
+                id: 1,
+                size: Some(Size::new(400, 400)),
+            },
+            Op::SetForcedSize {
+                id: 2,
+                size: Some(Size::new(400, 400)),
+            },
+            Op::SetForcedSize {
+                id: 3,
+                size: Some(Size::new(400, 400)),
+            },
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::Communicate(3),
+            Op::CompleteAnimations,
+        ],
+    );
+
+    // Active column is col 2 (window 3). Render order should be nearest-first: 3, 2, 1.
+    {
+        let ws = layout.active_workspace().unwrap();
+        let render_ids: Vec<usize> = ws
+            .tiles_with_render_positions()
+            .map(|(tile, _, _)| *tile.window().id())
+            .collect();
+        assert_eq!(render_ids, vec![3, 2, 1]);
+
+        let tile_by_id = |id| {
+            ws.tiles_with_render_positions()
+                .find(|(t, _, _)| *t.window().id() == id)
+                .map(|(t, pos, _)| {
+                    (
+                        t.focus_depth_scale(),
+                        t.focus_depth_opacity(),
+                        t.focus_depth_blur_options(),
+                        pos,
+                    )
+                })
+                .unwrap()
+        };
+
+        let (s3, a3, b3, p3) = tile_by_id(3);
+        let (s2, a2, b2, p2) = tile_by_id(2);
+        let (s1, a1, b1, p1) = tile_by_id(1);
+
+        assert_abs_diff_eq!(s3, 1.0, epsilon = 1e-5);
+        assert_abs_diff_eq!(a3, 1.0, epsilon = 1e-5);
+        assert!(b3.is_none());
+        assert_abs_diff_eq!(p3.x, 440.0, epsilon = 1e-5);
+
+        assert_abs_diff_eq!(s2, 0.9, epsilon = 1e-5);
+        assert_abs_diff_eq!(a2, 0.75, epsilon = 1e-5);
+        assert_eq!(b2.map(|b| b.passes), Some(2));
+        // Logical x2 = 440 - (400 + 16) = 24; pull = (400*0 + 400*0.1)*0.5 + 40 = 60 -> 84.
+        assert_abs_diff_eq!(p2.x, 84.0, epsilon = 1e-5);
+
+        assert_abs_diff_eq!(s1, 0.9, epsilon = 1e-5);
+        assert_abs_diff_eq!(a1, 0.75, epsilon = 1e-5);
+        assert_eq!(b1.map(|b| b.passes), Some(2));
+        // Cumulative left pull: 60 (from active->2) + (400*0.1 + 400*0.1)*0.5 + 40 = 140.
+        // Logical x1 = 24 - 416 = -392; visual = -392 + 140 = -252.
+        assert_abs_diff_eq!(p1.x, -252.0, epsilon = 1e-5);
+    }
+
+    // Focus middle column (window 2). Transitions should start seamlessly without a jump.
+    Op::FocusColumnLeft.apply(&mut layout);
+    {
+        let ws = layout.active_workspace().unwrap();
+        let find_id = |id| {
+            ws.tiles_with_render_positions()
+                .find(|(t, _, _)| *t.window().id() == id)
+                .map(|(t, _, _)| (t.focus_depth_scale(), t.focus_depth_opacity()))
+                .unwrap()
+        };
+        assert_abs_diff_eq!(find_id(2).0, 0.9, epsilon = 1e-5);
+        assert_abs_diff_eq!(find_id(3).0, 1.0, epsilon = 1e-5);
+    }
+
+    // Halfway through linear 1000ms transition.
+    Op::AdvanceAnimations { msec_delta: 500 }.apply(&mut layout);
+    {
+        let ws = layout.active_workspace().unwrap();
+        let find_id = |id| {
+            ws.tiles_with_render_positions()
+                .find(|(t, _, _)| *t.window().id() == id)
+                .map(|(t, _, _)| {
+                    (
+                        t.focus_depth_scale(),
+                        t.focus_depth_opacity(),
+                        t.focus_depth_blur_options(),
+                    )
+                })
+                .unwrap()
+        };
+        let (s2, a2, b2) = find_id(2);
+        let (s3, a3, b3) = find_id(3);
+        assert_abs_diff_eq!(s2, 0.95, epsilon = 1e-4);
+        assert_abs_diff_eq!(a2, 0.875, epsilon = 1e-4);
+        assert_eq!(b2.map(|b| b.passes), Some(2));
+        assert_abs_diff_eq!(s3, 0.95, epsilon = 1e-4);
+        assert_abs_diff_eq!(a3, 0.875, epsilon = 1e-4);
+        assert_eq!(b3.map(|b| b.passes), Some(2));
+    }
+
+    // Complete animations and check symmetric stacking + inverse hit-testing on col 0 & col 2.
+    Op::AdvanceAnimations { msec_delta: 500 }.apply(&mut layout);
+    let (p1, p2, p3) = {
+        let ws = layout.active_workspace().unwrap();
+        let pos_of = |id| {
+            ws.tiles_with_render_positions()
+                .find(|(t, _, _)| *t.window().id() == id)
+                .map(|(_, pos, _)| pos)
+                .unwrap()
+        };
+        (pos_of(1), pos_of(2), pos_of(3))
+    };
+
+    assert_abs_diff_eq!(p2.x, 440.0, epsilon = 1e-5);
+    assert_abs_diff_eq!(p1.x, 84.0, epsilon = 1e-5);
+    assert_abs_diff_eq!(p3.x, 796.0, epsilon = 1e-5);
+
+    let output = layout.outputs().next().unwrap().clone();
+    // Window 1 is 400x400 centered at +200,+200, scaled to 0.9 => visual box spans [20..380] from p1.
+    // Top-left of unscaled box (p1 + (5, 5)) must NOT hit window 1.
+    assert!(layout
+        .window_under(&output, p1 + Point::from((5.0, 5.0)))
+        .is_none());
+    // Old untucked logical position (x = 24 + 5) must NOT hit window 1 either.
+    assert!(layout
+        .window_under(&output, Point::from((29.0, p1.y + 200.0)))
+        .is_none());
+    // Inside the scaled & tucked box (p1 + (30, 30)) MUST hit window 1.
+    let (hit_win, _) = layout
+        .window_under(&output, p1 + Point::from((30.0, 30.0)))
+        .unwrap();
+    assert_eq!(*hit_win.id(), 1);
+    // Inside window 3's scaled & tucked box (p3 + (370, 200)) MUST hit window 3.
+    let (hit_win, _) = layout
+        .window_under(&output, p3 + Point::from((370.0, 200.0)))
+        .unwrap();
+    assert_eq!(*hit_win.id(), 3);
+
+    // Setting inactive_blur = 0.0 disables content blur while keeping scale/opacity.
+    let mut no_blur_options = (*layout.options).clone();
+    no_blur_options.layout.focus_depth.inactive_blur = 0.0;
+    layout.update_options(no_blur_options);
+    let ws = layout.active_workspace().unwrap();
+    assert!(ws
+        .tiles_with_render_positions()
+        .all(|(t, _, _)| t.focus_depth_blur_options().is_none()));
+}

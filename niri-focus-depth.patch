+/// Cached Dual-Kawase blur for an unfocused tile's offscreen texture.
+#[derive(Debug)]
+struct FocusDepthBlurCache {
+    id: Id,
+    blur: Option<Blur>,
+    blurred: Option<GlesTexture>,
+    last_src_id: Option<Id>,
+    last_src_commit: CommitCounter,
+    last_src_size: Size<i32, Buffer>,
+    last_options: Option<BlurOptions>,
+    commit: CommitCounter,
+}
+
+impl Default for FocusDepthBlurCache {
+    fn default() -> Self {
+        Self {
+            id: Id::new(),
+            blur: None,
+            blurred: None,
+            last_src_id: None,
+            last_src_commit: CommitCounter::default(),
+            last_src_size: Size::default(),
+            last_options: None,
+            commit: CommitCounter::default(),
+        }
+    }
+}
+
+impl FocusDepthBlurCache {
+    fn render_blur(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        src_elem: &OffscreenRenderElement,
+        options: BlurOptions,
+    ) -> Option<(GlesTexture, CommitCounter)> {
+        let src_tex = src_elem.texture();
+        let src_id = src_elem.id();
+        let src_commit = src_elem.current_commit();
+        let src_size = src_tex.size();
+
+        if let Some(tex) = &self.blurred {
+            if self.last_src_id.as_ref() == Some(src_id)
+                && self.last_src_commit == src_commit
+                && self.last_src_size == src_size
+                && self.last_options == Some(options)
+                && self
+                    .blur
+                    .as_ref()
+                    .is_some_and(|b| b.context_id() == renderer.context_id())
+            {
+                return Some((tex.clone(), self.commit));
+            }
+        }
+
+        // Release old reference before prepare_textures so Blur::textures[0].is_unique_reference() stays true.
+        self.blurred = None;
+
+        if self
+            .blur
+            .as_ref()
+            .is_some_and(|b| b.context_id() != renderer.context_id())
+        {
+            self.blur = None;
+        }
+
+        let blur = if let Some(blur) = &mut self.blur {
+            blur
+        } else {
+            let Some(blur) = Blur::new(renderer) else {
+                return None;
+            };
+            self.blur.insert(blur)
+        };
+
+        if let Err(err) = blur.prepare_textures(
+            |fourcc, size| renderer.create_buffer(fourcc, size),
+            src_tex,
+            options,
+        ) {
+            warn!("error preparing focus-depth window blur textures: {err:?}");
+            return None;
+        }
+
+        match blur.render(renderer, src_tex, options) {
+            Ok(blurred) => {
+                self.commit.increment();
+                self.blurred = Some(blurred.clone());
+                self.last_src_id = Some(src_id.clone());
+                self.last_src_commit = src_commit;
+                self.last_src_size = src_size;
+                self.last_options = Some(options);
+                Some((blurred, self.commit))
+            }
+            Err(err) => {
+                warn!("error rendering focus-depth window blur: {err:?}");
+                None
+            }
+        }
+    }
+}

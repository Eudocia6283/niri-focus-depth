+/// Offscreen render element with optional post-blur rounded-corner clipping for focus-depth.
+#[derive(Debug, Clone)]
+pub struct FocusDepthOffscreenElement {
+    id: Id,
+    texture: GlesTexture,
+    renderer_context_id: ContextId<GlesTexture>,
+    scale: Scale<f64>,
+    commit: CommitCounter,
+    offset: Point<f64, Logical>,
+    src_size: Size<i32, Buffer>,
+    alpha: f32,
+    clip: Option<(Rectangle<f64, Logical>, CornerRadius, f32)>,
+    clip_program: Option<GlesTexProgram>,
+}
+
+impl FocusDepthOffscreenElement {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        id: Id,
+        texture: GlesTexture,
+        renderer_context_id: ContextId<GlesTexture>,
+        scale: Scale<f64>,
+        commit: CommitCounter,
+        offset: Point<f64, Logical>,
+        src_size: Size<i32, Buffer>,
+        alpha: f32,
+        clip: Option<(Rectangle<f64, Logical>, CornerRadius, f32)>,
+        clip_program: Option<GlesTexProgram>,
+    ) -> Self {
+        Self {
+            id,
+            texture,
+            renderer_context_id,
+            scale,
+            commit,
+            offset,
+            src_size,
+            alpha,
+            clip,
+            clip_program,
+        }
+    }
+
+    pub fn logical_size(&self) -> Size<f64, Logical> {
+        self.src_size
+            .to_f64()
+            .to_logical(self.scale, Transform::Normal)
+    }
+}
+
+impl Element for FocusDepthOffscreenElement {
+    fn id(&self) -> &Id {
+        &self.id
+    }
+
+    fn current_commit(&self) -> CommitCounter {
+        self.commit
+    }
+
+    fn geometry(&self, scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        let logical_geo = Rectangle::new(self.offset, self.logical_size());
+        logical_geo.to_physical_precise_round(scale)
+    }
+
+    fn transform(&self) -> Transform {
+        Transform::Normal
+    }
+
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        Rectangle::from_size(self.src_size).to_f64()
+    }
+
+    fn opaque_regions(&self, _scale: Scale<f64>) -> OpaqueRegions<i32, Physical> {
+        OpaqueRegions::default()
+    }
+
+    fn alpha(&self) -> f32 {
+        self.alpha
+    }
+
+    fn kind(&self) -> Kind {
+        Kind::Unspecified
+    }
+}
+
+impl RenderElement<GlesRenderer> for FocusDepthOffscreenElement {
+    fn draw(
+        &self,
+        frame: &mut GlesFrame<'_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dest: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        _cache: Option<&UserDataMap>,
+    ) -> Result<(), GlesError> {
+        if frame.context_id() != self.renderer_context_id {
+            warn!("trying to render texture from different renderer");
+            return Ok(());
+        }
+
+        if let (Some((clip_geo, corner_radius, effective_scale)), Some(program)) =
+            (self.clip, &self.clip_program)
+        {
+            let buf_size_logical = self
+                .texture
+                .size()
+                .to_f64()
+                .to_logical(self.scale, Transform::Normal);
+            let buf_v = Vec2::new(buf_size_logical.w as f32, buf_size_logical.h as f32);
+            let geo_v = Vec2::new(clip_geo.size.w as f32, clip_geo.size.h as f32);
+            let off_v = Vec2::new(
+                (self.offset.x - clip_geo.loc.x) as f32,
+                (self.offset.y - clip_geo.loc.y) as f32,
+            );
+            let input_to_geo =
+                Mat3::from_scale(buf_v / geo_v) * Mat3::from_translation(off_v / buf_v);
+
+            let uniforms = [
+                Uniform::new("niri_scale", effective_scale),
+                Uniform::new("geo_size", [geo_v.x, geo_v.y]),
+                Uniform::new("corner_radius", <[f32; 4]>::from(corner_radius)),
+                mat3_uniform("input_to_geo", input_to_geo),
+            ];
+
+            frame.render_texture_from_to(
+                &self.texture,
+                src,
+                dest,
+                damage,
+                opaque_regions,
+                Transform::Normal,
+                self.alpha,
+                Some(program),
+                &uniforms,
+            )
+        } else {
+            frame.render_texture_from_to(
+                &self.texture,
+                src,
+                dest,
+                damage,
+                opaque_regions,
+                Transform::Normal,
+                self.alpha,
+                None,
+                &[],
+            )
+        }
+    }
+
+    fn underlying_storage(&self, _renderer: &mut GlesRenderer) -> Option<UnderlyingStorage<'_>> {
+        None
+    }
+}
+
+impl<'render> RenderElement<TtyRenderer<'render>> for FocusDepthOffscreenElement {
+    fn draw(
+        &self,
+        frame: &mut TtyFrame<'_, '_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        cache: Option<&UserDataMap>,
+    ) -> Result<(), TtyRendererError<'render>> {
+        let gles_frame = frame.as_gles_frame();
+        RenderElement::<GlesRenderer>::draw(
+            &self,
+            gles_frame,
+            src,
+            dst,
+            damage,
+            opaque_regions,
+            cache,
+        )?;
+        Ok(())
+    }
+
+    fn underlying_storage(
+        &self,
+        _renderer: &mut TtyRenderer<'render>,
+    ) -> Option<UnderlyingStorage<'_>> {
+        None
+    }
+}

+    /// Updates the focus-depth target for this tile.
+    ///
+    /// `overview_progress` relaxes the effect while the overview is open.
+    pub fn sync_focus_depth(&mut self, is_active: bool, overview_progress: f64) {
+        self.focus_depth.overview_progress = overview_progress.clamp(0., 1.);
+        let target_inactive = !is_active && !self.options.layout.focus_depth.off;
+
+        if !self.focus_depth.initialized {
+            self.focus_depth.initialized = true;
+            self.focus_depth.target_inactive = target_inactive;
+            self.focus_depth.anim = None;
+            return;
+        }
+
+        if self.focus_depth.target_inactive != target_inactive {
+            let current = self.focus_depth_raw_progress();
+            self.focus_depth.target_inactive = target_inactive;
+            let to = if target_inactive { 1. } else { 0. };
+            if (current - to).abs() <= 1e-4 {
+                self.focus_depth.anim = None;
+            } else {
+                self.focus_depth.anim = Some(Animation::new(
+                    self.clock.clone(),
+                    current,
+                    to,
+                    0.,
+                    self.options.animations.horizontal_view_movement.0,
+                ));
+            }
+        }
+    }
+
+    pub fn focus_depth_raw_progress(&self) -> f64 {
+        if let Some(anim) = &self.focus_depth.anim {
+            anim.value()
+        } else if self.focus_depth.target_inactive && !self.options.layout.focus_depth.off {
+            1.
+        } else {
+            0.
+        }
+    }
+
+    pub fn focus_depth_clamped_progress(&self) -> f64 {
+        if let Some(anim) = &self.focus_depth.anim {
+            anim.clamped_value().clamp(0., 1.)
+        } else if self.focus_depth.target_inactive && !self.options.layout.focus_depth.off {
+            1.
+        } else {
+            0.
+        }
+    }
+
+    fn focus_depth_factor(&self) -> f64 {
+        (1. - self.expanded_progress()) * (1. - self.focus_depth.overview_progress)
+    }
